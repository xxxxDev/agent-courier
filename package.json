{
  "name": "agent-courier",
  "version": "0.1.0",
  "description": "Messages between Claude Code sessions on your own machines, over SSH, with no third party",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "courier": "bin/courier.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node bin/courier.js serve",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src bin",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
